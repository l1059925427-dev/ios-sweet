diff --git a/bsd/dev/sweet_cpufreq_haydn.c b/bsd/dev/sweet_cpufreq_haydn.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_cpufreq_haydn.c
@@ -0,0 +1,204 @@
+/*
+ * SWEET haydn (SM8350) CPU frequency bring-up: measure the real core
+ * frequency with PMCCNTR_EL0 against the wall clock, then raise all three
+ * EPSS/OSM domains to their top LUT performance state.
+ *
+ * Motivation: the ABL leaves the CPUs at whatever frequency it booted with.
+ * If that is the lowest LUT row, everything (boot time, UI, input latency)
+ * is uniformly slow no matter how many cores are online, while the 19.2 MHz
+ * arch_timer keeps wall-clock time looking normal. cycles / wall clock is
+ * the ground truth; arch_timer timestamps are not.
+ *
+ * EPSS (lahaina) register map, from Linux qcom-cpufreq-hw.c epss_soc_data:
+ *   0x000 ENABLE          0x020 DOMAIN_STATE     0x0b0 DCVS_CTRL
+ *   0x100 FREQ_LUT        4-byte rows, up to 40; a zero row ends the table
+ *         bits[31:30] = PLL source, bits[7:0] = L value
+ *   0x200 VOLT_LUT        0x308 INTR_CLR         0x320 PERF_STATE
+ * Writing a row index to PERF_STATE switches frequency and voltage together
+ * in hardware; no RPMh vote is involved. haydn DT lists three cpufreq-hw
+ * domains: 0x18591000 / 0x18592000 / 0x18593000.
+ *
+ * Boot arg sweetcpufreq=0 disables the whole thing.
+ *
+ * Staged bring-up (v52diag black-screened with the thread started inside the
+ * CPU-start window, before its first print, so PMU/EPSS could not be
+ * exonerated): the thread now sleeps 2 s first and the boot arg selects how
+ * far it goes - 1 thread + one log line only (default), 2 add the PMU
+ * measurement (raw counters are logged; on haydn the ratio is not core MHz),
+ * 3 add a read-only EPSS dump (perf state + LUT rows), 4 add the EPSS raise.
+ * 0 still disables everything.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_cpufreq_haydn_init(void);
+
+#define SCP_ENABLE		0x000u
+#define SCP_DOMAIN_STATE	0x020u
+#define SCP_FREQ_LUT		0x100u
+#define SCP_PERF_STATE		0x320u
+#define SCP_LUT_MAX		40u
+
+static const uint32_t scp_domains[3] = { 0x18591000u, 0x18592000u, 0x18593000u };
+static int scp_sleep_chan;
+
+static uint32_t
+scp_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static uint64_t
+scp_cycles(void)
+{
+	uint64_t v = 0;
+	__asm__ volatile("isb" ::: "memory");
+	/* If EL2 traps the PMU this MRS is undefined; the sync-vector skip
+	 * patch steps over it and v stays 0, which shows up as 0 MHz. */
+	__asm__ volatile("mrs %0, PMCCNTR_EL0" : "=r"(v));
+	return v;
+}
+
+static void
+scp_pmu_enable(void)
+{
+	uint64_t v = 0;
+	__asm__ volatile("mrs %0, PMCR_EL0" : "=r"(v));
+	v |= 1ull; /* E: enable the PMU */
+	__asm__ volatile("msr PMCR_EL0, %0" :: "r"(v));
+	__asm__ volatile("msr PMCNTENSET_EL0, %0" :: "r"(1ull << 31)); /* C */
+	__asm__ volatile("isb" ::: "memory");
+}
+
+/* Sleep ~ms on this dedicated thread (IOSleep is IOKit C++ only). */
+static void
+scp_wait(unsigned int ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&scp_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Core frequency in MHz: PMCCNTR cycles over a wall-clock window. */
+static uint64_t
+scp_measure_mhz(unsigned int window_ms)
+{
+	uint64_t ns = 0;
+	uint64_t c0 = scp_cycles();
+	uint64_t t0 = mach_absolute_time();
+	scp_wait(window_ms);
+	uint64_t c1 = scp_cycles();
+	uint64_t t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	/* Raw values: on haydn the PMU counter does not count core clocks, so
+	 * the ratio has to be interpreted by hand from these numbers. */
+	printf("SWEET CPUFREQ: raw c0=%llu c1=%llu dc=%llu t0=%llu t1=%llu ns=%llu\n",
+	    c0, c1, c1 - c0, t0, t1, ns);
+	if (ns == 0) {
+		return 0;
+	}
+	return (c1 - c0) * 1000ull / ns;
+}
+
+static void
+scp_domain_raise(unsigned int idx, uint32_t pa, int do_raise)
+{
+	vm_offset_t base = ml_io_map(pa, 0x1000);
+	unsigned int rows = 0, top = 0;
+	uint32_t enable, dstate, cur, last = 0;
+	if (!base) {
+		printf("SWEET CPUFREQ: domain%u %#x: ml_io_map failed\n", idx, pa);
+		return;
+	}
+	enable = scp_rd(base, SCP_ENABLE);
+	dstate = scp_rd(base, SCP_DOMAIN_STATE);
+	cur = scp_rd(base, SCP_PERF_STATE);
+	for (unsigned int i = 0; i < SCP_LUT_MAX; ++i) {
+		uint32_t row = scp_rd(base, SCP_FREQ_LUT + 4u * i);
+		if (row == 0) {
+			break;
+		}
+		last = row;
+		rows = i + 1;
+	}
+	printf("SWEET CPUFREQ: domain%u %#x: enable=%#x dstate=%#x perf=%u rows=%u last-lut=%#x\n",
+	    idx, pa, enable, dstate, cur, rows, last);
+	if (rows == 0 || !do_raise) {
+		return;
+	}
+	top = rows - 1;
+	if (cur == top) {
+		printf("SWEET CPUFREQ: domain%u already at top perf state %u\n", idx, top);
+		return;
+	}
+	*(volatile uint32_t *)(base + SCP_PERF_STATE) = top;
+	__asm__ volatile("dsb osh" ::: "memory");
+	printf("SWEET CPUFREQ: domain%u perf %u -> %u (raised)\n", idx, cur, top);
+}
+
+static void
+scp_thread(void *arg, wait_result_t result)
+{
+	uint64_t before, after, cntfrq = 0;
+	int stage = (int)(uintptr_t)arg;
+	(void)result;
+	/* Let bsd init and the SMP bring-up finish first. */
+	scp_wait(2000);
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(cntfrq));
+	printf("SWEET CPUFREQ: thread alive stage=%d cntfrq=%llu\n", stage, cntfrq);
+	if (stage < 2) {
+		return;
+	}
+	scp_pmu_enable();
+	before = scp_measure_mhz(200);
+	printf("SWEET CPUFREQ: %llu MHz before raise\n", before);
+	if (stage < 3) {
+		return;
+	}
+	for (unsigned int i = 0; i < 3; ++i) {
+		scp_domain_raise(i, scp_domains[i], stage >= 4);
+	}
+	if (stage < 4) {
+		return;
+	}
+	scp_wait(50);
+	after = scp_measure_mhz(200);
+	printf("SWEET CPUFREQ: %llu MHz after raise\n", after);
+}
+
+void
+sweet_cpufreq_haydn_init(void)
+{
+	int stage = 1;
+	thread_t thread;
+	static bool started;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetcpufreq", &stage, sizeof(stage));
+	if (stage <= 0) {
+		printf("SWEET CPUFREQ: disabled (sweetcpufreq=0)\n");
+		return;
+	}
+	if (stage > 4) {
+		stage = 4;
+	}
+	kern_return_t kr = kernel_thread_start(scp_thread, (void *)(uintptr_t)stage, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET CPUFREQ: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
